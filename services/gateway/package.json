{
  "name": "boothnote-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Boothnote 网关 —— PWA 与 Twenty 之间的唯一写入闸门（§4.2 第1条）",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "migrate": "node src/migrate.ts",
