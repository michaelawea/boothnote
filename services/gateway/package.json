    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "officeparser": "5.1.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
