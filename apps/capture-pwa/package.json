{
  "name": "boothnote-capture-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Boothnote 写入端 —— 展会现场速记 PWA。离线优先，手机为主。",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@github/markdown-toolbar-element": "^2.2.3",
    "dexie": "^4.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.0.0"
  }
}
