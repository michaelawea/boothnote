# 复制成 .env 后填写。.env 不进 git（见 .gitignore）。
# 生成密钥：openssl rand -base64 32

# Twenty 镜像版本。官方同时发 amd64 与 arm64 —— Mac(M3) 与 VPS(x86) 拉同一个 tag 即可。
# 不要用 latest：本地和云上必须是同一个版本，否则行为不一致（D29）。
TAG=v2.25.1

# 本地：http://localhost:3000
# 云上：https://你的域名     ← MediaRecorder 要求 secure context，必须 https（§4.5 坑 2）
SERVER_URL=http://localhost:3000

# 数据库（容器内网络，密码不出容器；云上请换成强密码）
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432

REDIS_URL=redis://redis:6379

# openssl rand -base64 32
ENCRYPTION_KEY=
APP_SECRET=
# 仅在轮换密钥时填上一个 ENCRYPTION_KEY
FALLBACK_ENCRYPTION_KEY=

# 附件存储。V1 用本地磁盘；迁公司服务器或上量后换 S3 兼容（选欧盟区，R5）
STORAGE_TYPE=local
# STORAGE_S3_REGION=eu-central-1
# STORAGE_S3_NAME=
# STORAGE_S3_ENDPOINT=

# ── 以下是本项目自己的服务要用的，Twenty 不读 ──────────────────────────
# 公司的 OpenAI Key（D27）。转写 + 字段抽取都走它。
OPENAI_API_KEY=
# 我们自己的库（inbox / staging / IntelItem），与 Twenty 的 default 库隔离
APP_DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/boothnote

# Twenty 界面 Settings → API & Webhooks 生成，供 scripts/provision-twenty.mjs 使用
TWENTY_API_KEY=

# ── 生产部署（VPS）─────────────────────────────────────────
DEPLOY_HOST=root@203.0.113.10
DEPLOY_PATH=~/boothnote
CAPTURE_DOMAIN=capture.example.com
CRM_DOMAIN=crm.example.com
ACME_EMAIL=you@example.com          # Let's Encrypt 到期提醒
# TLS 模式（两行配套，改一个必须改另一个，详见 infra/caddy/Caddyfile 顶部）
#   Cloudflare Flexible（测试期）: SITE_SCHEME=http://   TLS_DIRECTIVE=
#   Cloudflare Full (strict)     : SITE_SCHEME=          TLS_DIRECTIVE=tls /certs/origin.pem /certs/origin.key
SITE_SCHEME=http://
TLS_DIRECTIVE=
GATEWAY_JWT_SECRET=          # openssl rand -base64 48
BACKUP_REMOTE=               # rclone remote，如 r2:boothnote-backup（欧盟区）

# 管理控制台。留空 = 控制台整个关闭（503）。openssl rand -base64 32
ADMIN_TOKEN=

# ── 订单门户的项目进度（D139–D142 · docs/portal-projects.md）──────────────
# 门户服务端调 http://127.0.0.1:4000/portal/* 时带的 X-Portal-Secret。
# 🔴 留空 = /portal/* 整组 503（安全默认）。openssl rand -base64 32
#    同一个值写进门户的 data/.projects-secret（chmod 600）。只有 维护者 生成。
PORTAL_SECRET=

# 录入 agent 的思考档位（D123）。minimal/low/medium/high/xhigh/max
# 🔴 不设不等于「服务端默认」—— 实测发出去的是 effort:none（思考关着）
AGENT_REASONING=high
# 开了 high 每轮更慢，超时默认跟着从 120s 提到 180s
AGENT_TIMEOUT_MS=180000

# ── 钉钉渠道（T93 · docs/dingtalk-api.md）────────────────────────────
# 钉钉流程调 /api/channels/dingtalk/events 时带的 X-Channel-Secret。
# 🔴 留空 = 渠道整个关闭（503）—— **展会前保持留空**。openssl rand -base64 32
CHANNEL_DINGTALK_SECRET=
# 出站回执的兜底 webhook（钉钉自定义机器人）。每个群自己的在管理台里配，
# 这一行只在「先拿一个群试点」时省事用。留空 = 只认管理台里配的。
DINGTALK_DEFAULT_WEBHOOK=
# L1 完整性门卫用的模型。留空 = 跟抽取用同一个。
GATE_MODEL=
# 钉钉来源自动入库的倒计时秒数（D143）：汇报发出后这么多秒写入 CRM，期间可点撤回链接。
# 0 = 关掉自动入库（回滚开关）。改了要 --force-recreate 重建网关。
CHANNEL_AUTOCOMMIT_SECONDS=60

# ── 实验室 agent（T94 · docs/lab-agent.md）：群里的**第二个** bot ────
# 空工具表 + 自己的 skill 目录（agent/skills-lab/）。
# 🔴 **secret 默认和上面那个共用** —— 两条钉钉流程填同一个值就行，这一行不用配。
#    只有想给它单独一把钥匙时才填（填了就以这个为准）。
CHANNEL_LAB_SECRET=
# 同群同人多少分钟内沿用同一段对话（滑动窗口）
LAB_SESSION_WINDOW_MIN=30
# 同步等多久再转「先 ack、稍后 webhook 补发」。要小于钉钉流程 HTTP 节点的超时
LAB_SYNC_WAIT_MS=12000
# 实验室 agent 的模型。留空 = 跟录入 agent 同一个（OPENAI_EXTRACT_MODEL）
LAB_MODEL=gpt-5.6-luna
# 思考档位 minimal/low/medium/high/xhigh/max。
# 🔴 不设不等于「服务端默认」—— 实测发出去的是 effort:none（思考关着）
LAB_REASONING=high

# ── 产品知识 skill（docs/lab-agent.md）────────────────────────────
# SharePoint 产品文档库的**匿名共享链接**（Anyone with the link）。
# 它对公司内所有人开放，bot 会把它发进群里让人自己打开原件。
# 能力只有那一个文件夹、只读；要撤销就在 SharePoint 里删掉这条链接。
# 留空 = agent 只能查本地资料和索引，下载不了文档。
PRODUCT_DOCS_SHARE_URL=
# EU 分销价那份参考资料。**刻意不进 git**（FOB/DDP/MSRP），所以要你手动放到
# 服务器的 data/ 目录下。🔴 **这里填的是容器里的路径** —— data/ 被只读挂成 /data-src。
#   宿主机： <仓库>/data/pricing.md
#   这里填： /data-src/pricing.md
# 不配 = agent 手上根本没有这份资料（群里问价会答「资料里没有」）。
PRODUCT_PRICING_FILE=
# 收窄：只让这几个群问定价（群名，逗号分隔）。**留空 = 所有群都能问**。
LAB_PRICING_GROUPS=
# 控制台挂载的路径。不好猜只是降噪，真正的门是上面那个 token
ADMIN_PATH=/console-换成一串随机字符

# 「看板」按钮跳去哪。**留空就行** —— 网关会用 https://${CRM_DOMAIN} 推出来（D67）。
# 只有当 CRM 挂在别的地址、或想直接跳到某个具体视图时才填这一行。
# 🔴 千万别填 http://server:3000 那种容器内网地址：网关自己连得上，别人的手机连不上，而且不报错。
BOARD_URL=
